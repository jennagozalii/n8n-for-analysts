    {
      "parameters": {
        "jsCode": "const formats = ['yyyy-MM-dd', 'dd/MM/yyyy', 'd MMM yyyy', 'd/M/yyyy'];\nfunction parseDate(value) {\nconst s = String(value ?? '').trim();\nfor (const f of formats) {\nconst d = DateTime.fromFormat(s, f);\nif (d.isValid) return d.toISODate();\n}\nreturn null;\n}\nconst seen = new Set();\nconst out = [];\nfor (const item of $input.all()) {\nconst r = item.json;\nconst claimId = String(r.claim_id).trim().toUpperCase();\nconst duplicate = seen.has(claimId);\nseen.add(claimId);\nconst amount = Number(String(r.amount).replace(/[^0-9.]/g, ''));\nconst type = String(r.claim_type).trim().toLowerCase();\nconst claimType = type.charAt(0).toUpperCase() + type.slice(1);\nconst claimDate = parseDate(r.claim_date);\nconst policyStart = parseDate(r.policy_start);\nconst daysSinceStart = claimDate && policyStart\n? \nMath.round(DateTime.fromISO(claimDate).diff(DateTime.fromISO(policyStart), \n'days').days)\n: null;\n\nconst flags = [];\nif (duplicate) flags.push('Duplicate claim ID');\nif (!claimDate) flags.push('Invalid claim date');\nif (amount > 20000) flags.push('Amount above RM 20,000');\nif (daysSinceStart !== null && daysSinceStart < 30) flags.push('Claim within 30 days of policy start');\nout.push({ json: {\nclaim_id: claimId,\npolicy_no: String(r.policy_no).trim(),\nclaim_type: claimType,\nclaim_date: claimDate,\npolicy_start: policyStart,\namount_myr: amount,\ndays_since_start: daysSinceStart,\nflagged: flags.length > 0,\nflag_reasons: flags.join('; ')\n}});\n}\nreturn out;"
      },
