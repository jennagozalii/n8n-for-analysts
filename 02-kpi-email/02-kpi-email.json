      "parameters": {
        "jsCode": "const rows = $input.all().map(item => item.json);\nconst latest = rows.map(r => r.date).sort().pop();\nconst day = rows.filter(r => r.date === latest);\nconst sum = key => day.reduce((s, r) => s + Number(r[key]), 0);\nconst totalPremium = sum('premium_myr');\nconst totalPolicies = sum('policies_sold');\nconst totalTarget = sum('target_myr');\nconst pct = ((totalPremium / totalTarget) * 100).toFixed(1);\nconst rowsHtml = day.map(r => {\nconst hit = Math.round((r.premium_myr / r.target_myr) * 100);\nconst color = hit < 80 ? '#c0392b' : '#222';\nreturn `<tr><td>${r.channel}</td><td>${r.policies_sold}</td>` +\n`<td>RM ${Number(r.premium_myr).toLocaleString()}</td>` +\n`<td style=\"color:${color}\">${hit}%</td></tr>`;\n}).join('');\nreturn [{ json: { date: latest, totalPremium, totalPolicies, pct, rowsHtml } \n}];"
      },
