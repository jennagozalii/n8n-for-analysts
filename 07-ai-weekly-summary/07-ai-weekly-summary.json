      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst weekOf = d => DateTime.fromISO(d).startOf('week').toISODate();\nconst weeks = [...new Set(rows.map(r => weekOf(r.date)))].sort();\nconst thisWeek = weeks[weeks.length - 1];\nconst lastWeek = weeks[weeks.length - 2];\nconst channels = [...new Set(rows.map(r => r.channel))];\n\nconst total = (ch, wk, key) => rows\n.filter(r => r.channel === ch && weekOf(r.date) === wk)\n.reduce((s, r) => s + Number(r[key]), 0);\n\nconst summary = channels.map(ch => {\nconst now = total(ch, thisWeek, 'premium_myr');\nconst prev = total(ch, lastWeek, 'premium_myr');\nconst target = total(ch, thisWeek, 'target_myr');\nreturn {\nchannel: ch,\npremium_this_week: now,\npremium_last_week: prev,\nchange_pct: prev ? Number(((now - prev) / prev * 100).toFixed(1)) : null,\npct_of_target: Number((now / target * 100).toFixed(1))\n\n  };\n});\nreturn [{ json: { week_starting: thisWeek, summary } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
